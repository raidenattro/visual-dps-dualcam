# 复制为 .env 后 docker compose up -d 自动注入
APT_MIRROR=mirrors.aliyun.com
PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
REDIS_PASSWORD=change-me

# Docker 构建 / 权重下载：GitHub 加速（153 推荐 ghfast.top，末尾勿加 /）
GITHUB_PROXY_BASE=https://ghfast.top
# OpenMMLab 加速：留空走官方；可用 ghproxy 前缀，例如：
# OPENMMLAB_MIRROR_BASE=https://ghfast.top/https://download.openmmlab.com
OPENMMLAB_MIRROR_BASE=

# 构建专用 HTTP 代理（153 公司代理填这里；WSL 勿用下面 HTTP_PROXY 项）
# BUILD_HTTP_PROXY=http://192.168.1.1:7890
# BUILD_HTTPS_PROXY=http://192.168.1.1:7890

# 仅 WSL 拉 docker 镜像：可配合 ~/bin/update-docker-proxy.sh
# HTTP_PROXY=http://172.26.128.1:7078
# HTTPS_PROXY=http://172.26.128.1:7078

# Docker Hub 镜像：sudo cp deploy/docker-daemon-mirror.json.example /etc/docker/daemon.json && sudo systemctl restart docker

UI_PORT=8045
MEDIAMTX_PUBLIC_HOST=127.0.0.1
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889
# WebRTC ICE（UDP+TCP；与 mediamtx.yml 内 webrtcLocal* 端口一致，compose 为 宿主机:容器 同端口映射）
MEDIAMTX_WEBRTC_ICE_PORT=8189

# UI / Event 镜像 tag（与 AGENTS.md 一致；由 ./scripts/build-ui-image.sh 写入）
# VISUAL_DPS_IMAGE_TAG=20260629-test-from-4841de6a-bc66c0c

# RTSP 最新帧缓冲 TTL（秒）：超时后推理视为无帧，避免断流后仍用旧帧出 pose/碰撞
RTSP_FRAME_BUFFER_TTL_SEC=1

# 容器日志 time= 与宿主机 date 对齐（国内默认 Asia/Shanghai）
# TZ=Asia/Shanghai

# 推理镜像（UI 拉起检测容器时使用；WSL 无 GPU 时请保持 0）
INFERENCE_USE_GPU=0
# 多路 infer 时限制 ORT/BLAS/OpenCV 线程，避免多容器 CPU 超订（默认每进程 1）
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
OPENCV_NUM_THREADS=1
INFERENCE_ORT_INTRA_OP_THREADS=1
INFERENCE_ORT_INTER_OP_THREADS=1
INFERENCE_LITE_GPU_IMAGE=visual-dps-inference-lite-gpu:latest
INFERENCE_LITE_IMAGE=visual-dps-inference-lite:latest

# 姿态 Stream 分片（部署后尽量不改 POSE_LOGICAL_SHARD_COUNT）
POSE_DELIVERY=stream
POSE_LOGICAL_SHARD_COUNT=16
POSE_STREAM_KEY_PREFIX=pose:stream
POSE_STREAM_KEY=pose:stream
POSE_STREAM_GROUP=event-workers

# 默认双 worker-2（0–7 / 8–15）。勿与 visual-dps-event-worker 同时跑。
# 改回单实例：COMPOSE_PROFILES=worker-2，并清空 START/END。
COMPOSE_PROFILES=worker-2,worker-2-dual
EVENT_WORKER_2_SHARD_START=0
EVENT_WORKER_2_SHARD_END=7
EVENT_WORKER_2B_SHARD_START=8
EVENT_WORKER_2B_SHARD_END=15
EVENT_WORKER_2_CONSUMER_NAME=worker-2-a
EVENT_WORKER_2B_CONSUMER_NAME=worker-2-b
