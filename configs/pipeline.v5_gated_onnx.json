{
  "name": "v5_gated_onnx",
  "description": "v5_gated，动作门控 A 使用 ONNX Runtime 推理",
  "pose_frame_interval": 2,
  "pick_state": {
    "scorer": "rule_expert"
  },
  "pair_state": {
    "enabled": true,
    "scorer": "linear_expert",
    "threshold": 0.20,
    "score_smooth": {
      "enabled": true,
      "window_frames": 5,
      "method": "ema",
      "ema_alpha": 0.4
    },
    "linear_expert": {
      "model_path": "output/train/v5_base/model.json"
    },
    "action_gate": {
      "enabled": true,
      "backend": "onnx",
      "threshold": 0.30,
      "model_path": "output/train/action_gate_v1/model.joblib",
      "onnx_path": "output/train/action_gate_v1/model.onnx",
      "window_frames": 30,
      "step": 2
    },
    "box_gate": {
      "enabled": true,
      "depth_ratio_min": 0.25,
      "center_dist_max": 99.0
    }
  },
  "box_trigger": {
    "enabled": true,
    "require_pick_state": false,
    "wrist_score_min": 0.15
  },
  "alarm": {
    "min_consecutive_frames": 1,
    "cooldown_frames": 0
  }
}
