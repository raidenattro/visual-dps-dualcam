{
  "name": "pairwise_v1",
  "description": "判定单元从「人」改为「人-货框」对；11 维 logistic（人体 5 维 + 框内位置几何）",
  "pose_frame_interval": 2,
  "pick_state": {
    "scorer": "rule_expert"
  },
  "pair_state": {
    "enabled": true,
    "scorer": "linear_expert",
    "threshold": 0.5,
    "score_smooth": {
      "enabled": true,
      "window_frames": 5,
      "method": "ema",
      "ema_alpha": 0.4
    },
    "linear_expert": {
      "model_path": "output/train/pair_logistic_v1/model.json"
    }
  },
  "box_trigger": {
    "enabled": true,
    "require_pick_state": false,
    "wrist_score_min": 0.3
  },
  "alarm": {
    "min_consecutive_frames": 3,
    "cooldown_frames": 0
  },
  "features": [
    "ankle_max_speed_norm",
    "arm_torso_angle_max",
    "elbow_angle_mean",
    "wrist_elevation_angle_max",
    "shoulder_hip_knee_angle_min",
    "depth_ratio",
    "margin_gap",
    "candidate_count",
    "center_dist_norm",
    "wrist_bearing_x",
    "wrist_bearing_y"
  ]
}
