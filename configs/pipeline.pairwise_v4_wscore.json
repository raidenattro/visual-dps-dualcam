{
  "name": "pairwise_v4_wscore",
  "description": "手腕门槛0.15 + 含手腕置信度特征",
  "pose_frame_interval": 2,
  "pick_state": {
    "scorer": "rule_expert"
  },
  "pair_state": {
    "enabled": true,
    "scorer": "linear_expert",
    "threshold": 0.24,
    "score_smooth": {
      "enabled": true,
      "window_frames": 5,
      "method": "ema",
      "ema_alpha": 0.4
    },
    "linear_expert": {
      "model_path": "output/train/v4_wscore/model.json"
    }
  },
  "box_trigger": {
    "enabled": true,
    "require_pick_state": false,
    "wrist_score_min": 0.15
  },
  "alarm": {
    "min_consecutive_frames": 2,
    "cooldown_frames": 0
  }
}